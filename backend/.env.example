# PostgreSQL connection string. Use a local Postgres install, Neon, Supabase, or Railway.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fuelbook?schema=public"

# JWT
JWT_SECRET="change-this-in-production-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Server
PORT=4000
NODE_ENV="development"

# CORS — frontend URL
FRONTEND_URL="http://localhost:3000"

# Reconciliation thresholds
DISCREPANCY_ML_THRESHOLD=500
DISCREPANCY_PAISE_THRESHOLD=5000
